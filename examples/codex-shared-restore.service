[Unit]
Description=Restore opted-in Codex shared tmux clients
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-shared restore --config %h/.config/codex-shared-sessions/sessions.json
RemainAfterExit=yes

[Install]
WantedBy=default.target
