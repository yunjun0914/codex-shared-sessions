[Unit]
Description=Restore Codex integration manager and branch-agent views
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-lab restore
RemainAfterExit=yes

[Install]
WantedBy=default.target
