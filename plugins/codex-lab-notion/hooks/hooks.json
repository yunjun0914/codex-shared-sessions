{
  "description": "Opt-in selected-workspace conversation capture and context handoff",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/notion_sync.py\" hook", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/notion_sync.py\" hook", "timeout": 5}]}],
    "SessionStart": [{"matcher": "startup|resume", "hooks": [{"type": "command", "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/notion_sync.py\" context", "timeout": 15, "additionalContextLimit": 4000}]}]
  }
}
